rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ملخصات التمارين: أي مدرسة تضيف ملخصاً جديداً فقط، ولا يقرؤها إلا صاحبة المبادرة
    match /events/{eventId} {
      allow create: if eventId.size() < 40
        && request.resource.data.keys().hasOnly(['sid','school','stage','type','scen','scenTitle','date','evacSec','countSec','classes','registered','presentToday','unresolved','autoMatched','qr','manual','lvMismatch','rateAvg','rateN','baselineMin','appV'])
        && request.resource.data.sid is string && request.resource.data.sid.size() < 20
        && request.resource.data.school is string && request.resource.data.school.size() < 120
        && request.resource.data.stage is string && request.resource.data.stage.size() < 40
        && request.resource.data.type is string && request.resource.data.type.size() < 40
        && request.resource.data.scenTitle is string && request.resource.data.scenTitle.size() < 80
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.registered is int && request.resource.data.registered < 5000
        && request.resource.data.classes is int && request.resource.data.classes < 300;
      allow read, delete: if request.auth != null
        && request.auth.token.email == 'ضعي_بريدك_هنا';
    }
  }
}
